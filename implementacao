Esse cálculo permite testar:

Precisão arbitrária.

Distribuição entre processos.

Comunicação MPI.

Consolidação dos resultados.

Execução serial e distribuída.

O programa divide o intervalo de cálculo entre os processos MPI. Cada processo calcula sua parcela com MPFR e o processo principal consolida os resultados.


cpp

#include <iostream>
#include <vector>
#include <string>
#include <cstdlib>
#include <stdexcept>
#include <algorithm>

#include <mpfr.h>

#ifdef ME_ENABLE_MPI
#include <mpi.h>
#endif

struct Config {
    unsigned long long n = 100000;
    int digits = 50;
};

int main(int argc, char** argv) {

#ifdef ME_ENABLE_MPI
    MPI_Init(&argc, &argv);

    int rank = 0;
    int world = 1;

    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &world);
#else
    int rank = 0;
    int world = 1;
#endif

    int exit_code = 0;

    try {
        Config config;

        if (argc > 1)
            config.n = std::stoull(argv[1]);

        if (argc > 2)
            config.digits = std::stoi(argv[2]);

        if (config.n == 0 ||
            config.digits < 1 ||
            config.digits > 1000) {
            throw std::invalid_argument(
                "Invalid calculation parameters"
            );
        }

        // Convert decimal precision to binary precision.
        const mpfr_prec_t bits =
            static_cast<mpfr_prec_t>(
                config.digits * 3.321928094887362
            ) + 32;

        const unsigned long long chunk =
            config.n / world;

        const unsigned long long remainder =
            config.n % world;

        const unsigned long long start =
            rank * chunk +
            std::min<unsigned long long>(rank, remainder) + 1;

        const unsigned long long count =
            chunk + (rank < remainder ? 1 : 0);

        const unsigned long long end =
            start + count;

        mpfr_t local_sum;
        mpfr_t term;

        mpfr_init2(local_sum, bits);
        mpfr_init2(term, bits);

        mpfr_set_zero(local_sum, 0);

        for (unsigned long long k = start; k < end; ++k) {

            mpfr_set_ui(term, k, MPFR_RNDN);
            mpfr_ui_div(term, 1, term, MPFR_RNDN);

            mpfr_add(
                local_sum,
                local_sum,
                term,
                MPFR_RNDN
            );
        }

        mpfr_clear(term);

        const int buffer_size = config.digits + 100;

        std::vector<char> output(buffer_size, '\0');

        mpfr_snprintf(
            output.data(),
            output.size(),
            "%.*Re",
            config.digits,
            local_sum
        );

        mpfr_clear(local_sum);

#ifdef ME_ENABLE_MPI

        std::vector<char> gathered;

        if (rank == 0) {
            gathered.resize(
                static_cast<size_t>(world) * buffer_size
            );
        }

        MPI_Gather(
            output.data(),
            buffer_size,
            MPI_CHAR,
            rank == 0 ? gathered.data() : nullptr,
            buffer_size,
            MPI_CHAR,
            0,
            MPI_COMM_WORLD
        );

        if (rank == 0) {

            mpfr_t total;
            mpfr_t partial;

            mpfr_init2(total, bits);
            mpfr_init2(partial, bits);

            mpfr_set_zero(total, 0);

            for (int i = 0; i < world; ++i) {

                const char* value =
                    gathered.data() +
                    static_cast<size_t>(i) * buffer_size;

                if (mpfr_set_str(
                    partial,
                    value,
                    10,
                    MPFR_RNDN
                ) != 0) {
                    throw std::runtime_error(
                        "Invalid worker result"
                    );
                }

                mpfr_add(
                    total,
                    total,
                    partial,
                    MPFR_RNDN
                );
            }

            std::cout << "MATH ENGINE 1.0\n";
            std::cout << "Operation: Harmonic Sum\n";
            std::cout << "N: " << config.n << "\n";
            std::cout << "Workers: " << world << "\n";
            std::cout << "Precision: "
                      << config.digits << " digits\n";

            mpfr_printf(
                "Result: %.*Rg\n",
                config.digits,
                total
            );

            mpfr_clear(total);
            mpfr_clear(partial);
        }

#else

        std::cout << "MATH ENGINE 1.0\n";
        std::cout << "Operation: Harmonic Sum\n";
        std::cout << "N: " << config.n << "\n";
        std::cout << "Workers: 1\n";
        std::cout << "Precision: "
                  << config.digits << " digits\n";

        mpfr_printf(
            "Result: %.*Rg\n",
            config.digits,
            local_sum
        );

#endif

    } catch (const std::exception& e) {

        std::cerr << "ENGINE ERROR: "
                  << e.what() << "\n";

        exit_code = 1;
    }

#ifdef ME_ENABLE_MPI
    MPI_Finalize();
#endif

    return exit_code;
}
Esta é uma primeira implementação demonstrativa. A versão de produção ainda precisará de tratamento de falhas MPI, validação distribuída de parâmetros e protocolo de resultados versionado.

