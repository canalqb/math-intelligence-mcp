5. Configuração CMake
Este primeiro CMake utiliza C++20, MPI, OpenMP, GMP e MPFR. O código inicial poderá ser compilado nos dois sistemas.


cmake

cmake_minimum_required(VERSION 3.20)

project(MATH_ENGINE
    VERSION 1.0.0
    LANGUAGES C CXX
)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

option(ME_ENABLE_MPI "Enable distributed processing" ON)
option(ME_ENABLE_OPENMP "Enable CPU parallelism" ON)

find_package(PkgConfig REQUIRED)

pkg_check_modules(MPFR REQUIRED IMPORTED_TARGET mpfr)
pkg_check_modules(GMP REQUIRED IMPORTED_TARGET gmp)

if(ME_ENABLE_MPI)
    find_package(MPI REQUIRED COMPONENTS CXX)
endif()

if(ME_ENABLE_OPENMP)
