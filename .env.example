# ==============================================================================
# MATHFORGE MCP - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# ATENÇÃO DE SEGURANÇA:
# 1. NUNCA faça commit do arquivo '.env' real para o repositório Git!
# 2. Copie este modelo para '.env' e preencha com seus valores locais:
#    cp .env.example .env
# 3. O arquivo '.env' está registrado no .gitignore e NUNCA deve ser sincronizado.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIÇOS EM NUVEM E APIS (SEGREDO: NUNCA COMPARTILHE)
# ------------------------------------------------------------------------------
# Chave de API do Render (apenas se for gerenciar o serviço via API CLI)
# Exemplo fictício: rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RENDER_API_KEY=

# Personal Access Token do GitHub (necessário apenas para scripts de automação)
# Exemplo fictício: ghp_xxxxxxxxxxxxxxxxxxxx ou github_pat_xxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÕES DO SERVIDOR MCP (HTTP / ASGI / STDIO)
# ------------------------------------------------------------------------------
# Porta de execução do servidor HTTP (no Render é injetada automaticamente como $PORT)
PORT=8000

# Host de escuta (0.0.0.0 para aceitar conexões externas em container/nuvem)
HOST=0.0.0.0

# Modo de transporte padrão: "http" ou "stdio"
MATHFORGE_TRANSPORT=http

# Precisão decimal padrão para avaliações matemáticas (número de dígitos)
MIMCP_DEFAULT_PRECISION=50

# Habilitar operações criptográficas de curva secp256k1 (1=ativo, 0=inativo)
MIMCP_ENABLE_CRYPTO=1

# ------------------------------------------------------------------------------
# 3. CAMINHOS DE BIBLIOTECAS NATIVAS (.DLL / .SO)
# ------------------------------------------------------------------------------
# ATENÇÃO: NUNCA use caminhos pessoais (ex: C:\Users\NomeUsuario\...)
# Aponte para pastas de sistema ou relativas ao projeto:
# Exemplo Windows: C:\Windows\System32\ice_secp256k1.dll ou ./ice_secp256k1.dll
# Repositório oficial para download: https://github.com/iceland2k14/secp256k1
ICE_DLL_PATH=./ice_secp256k1.dll

# ------------------------------------------------------------------------------
# 4. ITENS TERMINANTEMENTE PROIBIDOS DE SINCRONIZAÇÃO NO REPOSITÓRIO:
# ------------------------------------------------------------------------------
# [X] Arquivo '.env' com chaves reais
# [X] Tokens de acesso do GitHub (github_pat_*, ghp_*)
# [X] Chaves de API do Render (rnd_*)
# [X] Chaves privadas de criptografia (*.key, *.pem, *.priv)
# [X] Caminhos absolutos pessoais de diretórios de usuários (C:\Users\...)
# [X] Caches compilados Python (__pycache__, *.pyc)
# [X] Arquivos temporários de diff (diff_*.txt)
