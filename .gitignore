# ==========================================
# MATHFORGE MCP - REGRAS DE EXCLUSÃO GIT (.gitignore)
# ==========================================

# 1. SEGREDOS E VARIÁVEIS DE AMBIENTE (NUNCA SINCRONIZAR)
.env
.env.*
!.env.example
*.pem
*.key
*.priv
*.cert
*.secrets

# 2. DEPENDÊNCIAS
node_modules/
pnpm-lockfile.lock
yarn-lockfile.lock
pnpm-debug.log
.venv/
env/
venv/
ENV/

# 3. PYTHON CACHES E ARTEFATOS
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# 4. BINÁRIOS E EXECUTÁVEIS LOCAIS
*.dll
*.exe
*.so
*.dylib
*.obj
*.o
*.a
*.lib

# 5. SCRIPTS E ARQUIVOS TEMPORÁRIOS / LOGS
*.log
*.tmp
*.bak
*.orig
*~
#*#
diff_*.txt
*.dump

# 6. RUST & TYPESCRIPT BUILDS
target/
.cargo/
dist/
*.tsbuildinfo
.tspkg

# 7. SISTEMA OPERACIONAL & IDES
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.mcpe-override
